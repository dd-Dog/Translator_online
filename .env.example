# API密钥配置
# 复制此文件为 .env 并填入你的API密钥

# OpenAI API密钥 (用于Planner, Checker, Aggregator)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API密钥 (用于Gemini和Claude，国内推荐使用)
# 获取地址: https://openrouter.ai/
# 注意：Gemini和Claude通过OpenRouter调用，使用同一个API密钥
OPENROUTER_API_KEY=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

# Qwen API密钥 (用于Translator-B对照译和Stylist)
# 获取地址: https://dashscope.console.aliyun.com/
QWEN_API_KEY=your_qwen_api_key_here

# DeepSeek API密钥 (可选，可替代Qwen用于Translator-B和Stylist)
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 以下为旧配置（如果直接使用Gemini/Claude官方API，不推荐国内使用）
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here